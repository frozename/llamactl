{
  "name": "@llamactl/app",
  "version": "0.0.0",
  "description": "Bun-served web console for llamactl.",
  "author": "Alexandre Cordeiro <alexandre.s.b.cordeiro@gmail.com>",
  "type": "module",
  "scripts": {
    "build": "vite build -c vite.web.config.ts",
    "build:web": "vite build -c vite.web.config.ts",
    "e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit --tsBuildInfoFile /dev/null && tsc -p tsconfig.e2e.json --noEmit --tsBuildInfoFile /dev/null",
    "test": "bun test"
  },
  "dependencies": {
    "@llamactl/core": "workspace:*",
    "@llamactl/remote": "workspace:*",
    "@tanstack/react-query": "5.99.0",
    "@trpc/client": "11.16.0",
    "@trpc/react-query": "11.16.0",
    "@trpc/server": "11.16.0",
    "eventsource": "4.1.0",
    "lucide-react": "1.8.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "superjson": "2.2.6",
    "yaml": "2.8.3",
    "zod": "4.6.6",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@tailwindcss/vite": "4.2.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "tailwindcss": "4.2.2",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
